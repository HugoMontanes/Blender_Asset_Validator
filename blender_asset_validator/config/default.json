{
  "naming": {
    "pattern": "^[A-Z][a-zA-Z0-9_]+$",
    "description": "PascalCase — starts with uppercase, letters/numbers/underscores only"
  },
  "geometry": {
    "max_triangles": 50000,
    "allow_ngons": false,
    "check_uvs": true,
    "check_degenerate_faces": true,
    "check_normals": true,
    "check_manifold": true,
    "check_shading": true,
    "degenerate_face_area_epsilon": 1e-10
  },
  "uv": {
    "texture_size": 2048,
    "texel_density": 512,
    "texel_density_description": "Target px per metre at texture_size (512 indie/PC, 1024 AAA); 0 = no target",
    "texel_tolerance": 0.2,
    "max_area_stretch": 0.3,
    "max_angle_stretch": 10.0,
    "min_island_gap_px": 8,
    "tiling_materials": "(?i)(tiling|tileable|trim)",
    "tiling_materials_description": "Regex on material names whose UVs may leave 0-1 on purpose",
    "require_lightmap": false
  },
  "optimization": {
    "merge_by_distance": true,
    "merge_distance": 0.0001,
    "fix_degenerate_faces": true,
    "degenerate_merge_distance": 0.0001
  },
  "topology": {
    "check_topology": true,
    "max_pole_valence": 5,
    "pole_curvature_angle": 10.0,
    "min_triangle_quality": 0.1,
    "max_quad_warp": 10.0,
    "flat_angle": 1.0,
    "feature_angle": 30.0,
    "quad_angle": 40.0,
    "relax_iterations": 5,
    "relax_factor": 0.5
  },
  "lod": {
    "collection": "LODs",
    "clean_topology": false,
    "export_target": "none",
    "export_target_description": "none (LODs not exported) | unreal (FBX LOD Group) | unity (Name_LOD0..n in one FBX). Set by the Engine dropdown",
    "levels": [
      {"suffix": "_LOD1", "ratio": 0.5},
      {"suffix": "_LOD2", "ratio": 0.25},
      {"suffix": "_LOD3", "ratio": 0.1}
    ]
  },
  "roles": {
    "_description": "Regexes on object names. collision: meshes exported with the mesh named by its (?P<owner>...) group; socket: empties parented to an asset. Set by the Engine dropdown"
  },
  "transforms": {
    "check_location": true,
    "check_rotation": true,
    "check_scale": true,
    "location_threshold": 0.001,
    "rotation_threshold": 0.001,
    "scale_threshold": 0.001
  },
  "materials": {
    "require_material": true,
    "check_textures": true
  },
  "export": {
    "format": "fbx",
    "format_description": "fbx | gltf (.glb)",
    "path": "//exports/",
    "axis_forward": "X",
    "axis_up": "Y",
    "apply_unit_scale": true,
    "apply_scale_options": "FBX_SCALE_NONE",
    "bake_space_transform": false,
    "use_selection": true,
    "use_active_collection": false,
    "individual_files": true,
    "global_scale": 1.0,
    "use_mesh_modifiers": true,
    "mesh_smooth_type": "OFF",
    "use_tspace": false,
    "use_armature_deform_only": false,
    "add_leaf_bones": false,
    "primary_bone_axis": "Y",
    "secondary_bone_axis": "X",
    "armature_nodetype": "NULL",
    "path_mode": "AUTO"
  }
}
