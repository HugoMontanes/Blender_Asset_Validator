{
  "naming": {
    "pattern": "^[A-Z][a-zA-Z0-9_]+$",
    "description": "PascalCase — starts with uppercase, letters/numbers/underscores only"
  },
  "geometry": {
    "max_triangles": 50000,
    "allow_ngons": false,
    "check_uvs": true,
    "check_degenerate_faces": true,
    "degenerate_face_area_epsilon": 1e-10
  },
  "optimization": {
    "auto_decimate": true,
    "merge_by_distance": true,
    "merge_distance": 0.0001,
    "fix_degenerate_faces": true,
    "degenerate_merge_distance": 0.0001
  },
  "lod": {
    "collection": "LODs",
    "export_target": "none",
    "export_target_description": "none | unreal (one fbx per asset with LOD siblings) | unity_godot (one fbx per LOD level)",
    "levels": [
      {"suffix": "_LOD1", "ratio": 0.5},
      {"suffix": "_LOD2", "ratio": 0.25},
      {"suffix": "_LOD3", "ratio": 0.1}
    ]
  },
  "transforms": {
    "check_location": true,
    "check_rotation": true,
    "check_scale": true,
    "location_threshold": 0.001,
    "rotation_threshold": 0.001,
    "scale_threshold": 0.001
  },
  "materials": {
    "require_material": true,
    "check_textures": true
  },
  "export": {
    "path": "//exports/",
    "axis_forward": "X",
    "axis_up": "Y",
    "apply_unit_scale": true,
    "apply_scale_options": "FBX_SCALE_NONE",
    "bake_space_transform": false,
    "use_selection": true,
    "use_active_collection": false,
    "individual_files": true,
    "global_scale": 1.0,
    "use_mesh_modifiers": true,
    "mesh_smooth_type": "OFF",
    "use_tspace": false,
    "use_armature_deform_only": false,
    "add_leaf_bones": false,
    "primary_bone_axis": "Y",
    "secondary_bone_axis": "X",
    "armature_nodetype": "NULL",
    "path_mode": "AUTO"
  }
}
